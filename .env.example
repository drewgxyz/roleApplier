# Anthropic Claude API Key - Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== TESTING FLAGS =====
# Set to true/false to enable/disable each variant (saves LLM calls during testing)
ENABLE_PROFESSIONAL=false
ENABLE_TECHNICAL=false
ENABLE_IMPACT=true

# Set to false to skip cover letter generation (saves 1 LLM call per job)
ENABLE_COVER_LETTER=false

# Set to false to skip the enhancement pass (saves 1 LLM call per variant)
ENABLE_ENHANCEMENT=true
